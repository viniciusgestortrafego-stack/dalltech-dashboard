# Login da página de Configurações (obrigatório para poder salvar as credenciais)
SETTINGS_AUTH_USER=
SETTINGS_AUTH_PASSWORD=

# Armazenamento das credenciais e dos dados do Google Ads (Vercel Blob → Storage → Create → Blob, store PRIVADO).
# Sem isso, o app guarda em memória (só serve para testar localmente).
BLOB_READ_WRITE_TOKEN=

# Opcional: versão da Graph API da Meta (padrão v23.0)
# META_GRAPH_VERSION=v23.0

# Tudo o mais (token da Meta, ID da conta de anúncios, ID do Instagram, chave do webhook do Google Ads)
# é preenchido dentro do app, em /settings. Nunca commite valores reais.
